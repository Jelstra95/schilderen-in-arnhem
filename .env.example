# Supabase — Project Settings > API
# Copy this file to `.env.local` and fill in real values. NEVER commit secrets.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only service-role key (NEVER expose to the client / commit).
# Used for admin operations: creating participant accounts, streaming private files.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket that holds the protected course materials (created in the migration).
SUPABASE_MATERIALS_BUCKET=course-materials

# Shared secret for the daily keep-alive cron (/api/cron/keepalive), which stops
# the Supabase free tier from pausing the project. Set the same value in Vercel:
# it sends it automatically as the `Authorization: Bearer ...` header.
# Use a random string of 16+ characters.
CRON_SECRET=a-long-random-string

# Google Search Console verification token (the content of the
# <meta name="google-site-verification"> tag). Optional: when unset the tag is
# simply omitted. Set it in Vercel to verify the production domain.
GOOGLE_SITE_VERIFICATION=

# Resend (transactional email). When RESEND_API_KEY is unset the email module
# logs messages to the server console instead of sending — useful for local dev
# without a real key. Get a key at resend.com and verify the sender domain for
# jellevanderidder.com (DKIM + SPF records).
RESEND_API_KEY=
# Verified sender address, e.g. "Schilderen in Arnhem <info@jellevanderidder.com>".
# Must be on a Resend-verified domain, otherwise mail is rejected.
RESEND_FROM="Schilderen in Arnhem <info@jellevanderidder.com>"
# Where owner-notification emails are delivered (new inquiries, new enrollments).
OWNER_EMAIL=info@jellevanderidder.com
# Public site URL used in email links (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://schilderen-in-arnhem.nl
